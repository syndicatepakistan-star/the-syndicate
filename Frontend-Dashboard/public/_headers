# Cloudflare Pages / CDN edge headers (also mirrored in next.config.js headers()).
# Put the-syndicate.com behind Cloudflare (orange-cloud proxy) so /_next/static,
# /_next/image, and /assets/* are served from edge PoPs (fixes London/Mumbai vs US gap).

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/_next/image*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=2592000

/assets/*.mp4
  Cache-Control: public, max-age=604800, s-maxage=2592000
  CDN-Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
